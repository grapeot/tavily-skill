# Copy to .env locally (never commit secrets).
TAVILY_API_KEY=
# ONEPASSWORD_TAVILY_REFERENCE=op://Vault/Item/field_name
# Point all auto-written payloads at one dedicated, persistent directory
# (e.g. a knowledge-base web_snapshots/raw folder) instead of the ephemeral
# CWD-relative ./tmp/tavily/. Strongly recommended so search/extract payloads
# accumulate as a timestamped corpus of primary sources.
# TAVILY_CLI_OUTPUT_DIR=/absolute/path/to/web_snapshots/raw
